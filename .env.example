# Required: create a bot with @BotFather and paste its token here
BOT_TOKEN=

# Optional admin Telegram user IDs, comma-separated
ADMIN_IDS=

# Language: ar or en
DEFAULT_LANG=ar

# Upload and processing limits
MAX_FILE_MB=20
MAX_FILES_PER_JOB=30
MAX_PDF_PAGES=300
OCR_MAX_PAGES=40
OCR_LANGS=ara+eng
WORKERS=3
JOB_TIMEOUT_SEC=300

# Storage
TEMP_DIR=/tmp/toolsbot
DB_PATH=data/bot.db

# HTML/URL to PDF
ALLOW_URL_FETCH=true

# Optional: Local Telegram Bot API server URL (leave empty for standard Telegram Cloud API)
LOCAL_API_URL=
